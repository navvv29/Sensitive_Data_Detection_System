# LLM API Configuration
# Gemini API (default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (alternative provider — set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=your_openai_api_key_here

# Groq API (alternative provider — set LLM_PROVIDER=groq to use)
# GROQ_API_KEY=your_groq_api_key_here

# LLM Provider selection: "gemini" (default), "openai", or "groq"
LLM_PROVIDER=gemini

# Optional: spaCy model override (default: en_core_web_sm)
# SPACY_MODEL=en_core_web_sm
